# Copy this file to .env and fill in the values:  cp .env.example .env
# Only SECRET_KEY is required; everything else has a working default.

# --- Auth -------------------------------------------------------------------
# Secret used to sign login tokens (JWT). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# How long a login stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server -----------------------------------------------------------------
# Port the app is published on: http://localhost:8000
API_PORT=8000

# --- LLM (Ollama) -----------------------------------------------------------
# Chat model. Downloaded automatically on first `docker compose up`.
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
# Maximum length of an answer, in tokens.
LLM_MAX_TOKENS=200
# Give up on an answer after this many seconds (CPU inference is slow).
LLM_TIMEOUT_SECONDS=120

# --- Retrieval --------------------------------------------------------------
# Passages retrieved per question, and the maximum context length sent to the model.
RETRIEVAL_K=3
MAX_CONTEXT_CHARS=3600
# Minimum cosine similarity for a question to count as in scope. Tuned on the
# dev set with `python evaluate.py --tune`; re-tune if you change data or models.
MIN_RELEVANCE_SCORE=0.45

# Embedding model. The Docker image ships with this one only; changing it needs
# internet access (HF_HUB_OFFLINE=0) and a rebuilt store (python ingest.py --rebuild).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Local runs without Docker only (Docker Compose sets these itself) -------
# DATABASE_URL=sqlite:///./medical_chatbot.db
# CHROMA_DIR=./chromadb_store
# DATASET_PATH=medquad.csv
# OLLAMA_BASE_URL=http://localhost:11434
