# Copy this file to .env and fill in the values:  cp .env.example .env

# Secret used to sign login tokens (JWT). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Ollama chat model. Downloaded automatically on first `docker compose up`.
OLLAMA_MODEL=llama3.2:3b

# Port the app is published on: http://localhost:8000
API_PORT=8000
